---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container--wide footer__inner">
    <p class="footer__copy">© {year} Ton Nom — Tous droits réservés</p>
    <div class="footer__links">
      <a href="https://github.com/maxeouw" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <i data-lucide="github" width="18" height="18"></i>
      </a>
      <a href="https://linkedin.com/in/tonpseudo" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <i data-lucide="linkedin" width="18" height="18"></i>
      </a>
      <a href="mailto:edwardgay02@yahoo.com" aria-label="Email">
        <i data-lucide="mail" width="18" height="18"></i>
      </a>
    </div>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--color-divider);
  padding-block: var(--space-8);
  margin-top: var(--space-24);
}
.footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.footer__copy {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.footer__links {
  display: flex;
  gap: var(--space-4);
}
.footer__links a {
  color: var(--color-text-muted);
  transition: color var(--transition-interactive);
}
.footer__links a:hover { color: var(--color-primary); }
</style>
