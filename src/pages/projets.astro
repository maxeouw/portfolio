---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// ✏️ PERSONNALISE CES PROJETS
const projects = [
  {
    id: 1,
    title: "TFE — Réseau d'événements sportifs",
    description: "Application web permettant aux sportifs de créer, rejoindre et gérer des événements. Authentification Google OAuth, base de données temps réel Firestore, interface responsive.",
    longDesc: "Projet de fin d'études développé dans le cadre de mon cursus à l'EPHEC. L'objectif était de créer une plateforme permettant aux cyclistes et sportifs de se retrouver autour d'événements locaux.",
    tags: ["Astro", "Firebase", "TypeScript", "OAuth"],
    category: "tfe",
    status: "En cours",
    statusType: "progress",
    year: "2026",
    github: "https://github.com/tonpseudo/tfe-sport",
    demo: null,
    highlights: [
      "Authentification Google OAuth",
      "Base de données Firestore temps réel",
      "Carte interactive des événements",
      "Interface responsive mobile-first",
    ],
  },
  {
    id: 2,
    title: "Module Odoo — Gestion personnalisée",
    description: "Module Odoo 17 développé en stage, ajoutant des fonctionnalités métier spécifiques à l'ERP. Vues, modèles de données et logique métier en Python et XML.",
    longDesc: "Développé en entreprise lors de mon stage, ce module étend les capacités natives d'Odoo 17 avec des workflows adaptés aux besoins du client.",
    tags: ["Python", "Odoo 17", "XML", "PostgreSQL"],
    category: "professionnel",
    status: "Terminé",
    statusType: "done",
    year: "2025",
    github: null,
    demo: null,
    highlights: [
      "Modèles de données personnalisés",
      "Vues Kanban et liste",
      "Logique métier Python",
      "Intégration native Odoo 17",
    ],
  },
  {
    id: 3,
    title: "Portfolio — Ce site",
    description: "Site portfolio personnel développé avec Astro, sans framework JavaScript côté client. Design system custom, dark mode, animations CSS scroll-driven et déploiement sur Vercel.",
    longDesc: "Conçu de A à Z pour présenter mon parcours et mes projets. L'occasion d'explorer Astro, les CSS view transitions et un design system cohérent.",
    tags: ["Astro", "CSS", "JavaScript", "Vercel"],
    category: "personnel",
    status: "En cours",
    statusType: "progress",
    year: "2026",
    github: "https://github.com/tonpseudo/portfolio",
    demo: "https://monportfolio.dev",
    highlights: [
      "Zéro JavaScript côté client par défaut",
      "Dark / light mode natif",
      "Design system Nexus custom",
      "Déploiement automatique Vercel",
    ],
  },
];

// Toutes les catégories uniques pour le filtre
const categories = [
  { value: "tous", label: "Tous" },
  { value: "tfe", label: "TFE" },
  { value: "professionnel", label: "Stage / Pro" },
  { value: "personnel", label: "Personnel" },
];
---

<BaseLayout title="Projets" description="Mes projets personnels, professionnels et mon TFE de fin d'études.">
  <Header slot="header" />

  <!-- ── EN-TÊTE PAGE ── -->
  <section class="page-hero">
    <div class="container">
      <p class="page-hero__label">
        <i data-lucide="folder-open" width="14" height="14"></i>
        Mes réalisations
      </p>
      <h1 class="page-hero__title">Projets</h1>
      <p class="page-hero__desc">
        Une sélection de projets développés dans le cadre de mes études, d'un stage et en autodidacte.
        Chaque projet est une occasion d'apprendre et d'améliorer mes pratiques.
      </p>
    </div>
  </section>

  <!-- ── FILTRES ── -->
  <section class="filters-section">
    <div class="container">
      <div class="filters" role="group" aria-label="Filtrer les projets par catégorie">
        {categories.map(cat => (
          <button
            class="filter-btn"
            data-filter={cat.value}
            aria-pressed={cat.value === "tous" ? "true" : "false"}
            type="button"
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ── GRILLE DE PROJETS ── -->
  <section class="projects-section">
    <div class="container">
      <div class="projects-grid" id="projects-grid">
        {projects.map((project) => (
          <article
            class="project-card"
            data-category={project.category}
            id={`project-${project.id}`}
          >
            <!-- En-tête de la carte -->
            <div class="project-card__head">
              <div class="project-card__meta">
                <span class="project-year">{project.year}</span>
                <span class:list={["project-status", `project-status--${project.statusType}`]}>
                  {project.statusType === "done"
                    ? <><i data-lucide="check-circle" width="12" height="12"></i> {project.status}</>
                    : <><i data-lucide="loader" width="12" height="12"></i> {project.status}</>
                  }
                </span>
              </div>
              <div class="project-card__links">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="Voir le code sur GitHub">
                    <i data-lucide="github" width="16" height="16"></i>
                  </a>
                )}
                {project.demo && (
                  <a href={project.demo} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="Voir la démo">
                    <i data-lucide="external-link" width="16" height="16"></i>
                  </a>
                )}
              </div>
            </div>

            <!-- Corps -->
            <div class="project-card__body">
              <h2 class="project-card__title">{project.title}</h2>
              <p class="project-card__desc">{project.description}</p>

              <!-- Points clés -->
              <ul role="list" class="project-highlights">
                {project.highlights.map(h => (
                  <li class="project-highlight">
                    <i data-lucide="chevron-right" width="13" height="13"></i>
                    {h}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Pied de carte -->
            <div class="project-card__foot">
              <ul role="list" class="project-tags">
                {project.tags.map(tag => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <!-- État vide si aucun projet ne correspond au filtre -->
      <div class="empty-state" id="empty-state" hidden>
        <div class="empty-state__icon">
          <i data-lucide="search-x" width="32" height="32"></i>
        </div>
        <h3>Aucun projet dans cette catégorie</h3>
        <p>D'autres projets arrivent bientôt.</p>
        <button class="btn btn--ghost" id="reset-filter" type="button">
          Voir tous les projets
        </button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<!-- ── LOGIQUE FILTRE ── -->
<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const emptyState = document.getElementById('empty-state');
  const resetBtn = document.getElementById('reset-filter');

  function applyFilter(value: string) {
    let visible = 0;

    // Mise à jour des boutons
    filterBtns.forEach(btn => {
      const active = btn.dataset.filter === value;
      btn.setAttribute('aria-pressed', String(active));
    });

    // Affichage / masquage des cartes
    cards.forEach(card => {
      const match = value === 'tous' || card.dataset.category === value;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    // État vide
    if (emptyState) emptyState.hidden = visible > 0;
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'tous'));
  });

  resetBtn?.addEventListener('click', () => applyFilter('tous'));
</script>

<style>
/* ── PAGE HERO ── */
.page-hero {
  padding-block: clamp(var(--space-12), 8vw, var(--space-24));
  border-bottom: 1px solid var(--color-divider);
}

.page-hero__label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
  margin-bottom: var(--space-3);
}

.page-hero__title {
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--color-text);
  margin-bottom: var(--space-4);
}

.page-hero__desc {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  max-width: 58ch;
  line-height: 1.7;
}

/* ── FILTRES ── */
.filters-section {
  padding-block: var(--space-6);
  position: sticky;
  top: 61px; /* hauteur du header */
  z-index: 10;
  background: color-mix(in oklab, var(--color-bg) 92%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-divider);
}

.filters {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.filter-btn {
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  background: transparent;
  border: 1px solid var(--color-border);
  min-height: 36px;
  cursor: pointer;
  transition:
    color var(--transition-interactive),
    background var(--transition-interactive),
    border-color var(--transition-interactive);
}

.filter-btn:hover {
  color: var(--color-text);
  border-color: var(--color-text-muted);
  background: var(--color-surface-offset);
}

.filter-btn[aria-pressed="true"] {
  color: var(--color-primary);
  background: var(--color-primary-highlight);
  border-color: var(--color-primary);
}

/* ── GRILLE PROJETS ── */
.projects-section {
  padding-block: clamp(var(--space-10), 6vw, var(--space-20));
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
  gap: var(--space-6);
}

/* ── CARTE PROJET ── */
.project-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  box-shadow: var(--shadow-sm);
  transition:
    box-shadow var(--transition-interactive),
    transform var(--transition-interactive),
    border-color var(--transition-interactive);
}

.project-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
  border-color: var(--color-primary-highlight);
}

/* Head */
.project-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project-card__meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.project-year {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-faint);
  letter-spacing: 0.05em;
}

.project-status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-xs);
  font-weight: 500;
  padding: 3px var(--space-2);
  border-radius: var(--radius-full);
}

.project-status--done {
  color: #437a22;
  background: #d4dfcc;
}

[data-theme="dark"] .project-status--done {
  color: #6daa45;
  background: #3a4435;
}

.project-status--progress {
  color: #964219;
  background: #ddcfc6;
}

[data-theme="dark"] .project-status--progress {
  color: #bb653b;
  background: #564942;
}

.project-card__links {
  display: flex;
  gap: var(--space-2);
}

.icon-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-md);
  color: var(--color-text-faint);
  border: 1px solid var(--color-border);
  transition:
    color var(--transition-interactive),
    background var(--transition-interactive),
    border-color var(--transition-interactive);
}

.icon-link:hover {
  color: var(--color-primary);
  border-color: var(--color-primary-highlight);
  background: var(--color-primary-highlight);
}

/* Body */
.project-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.project-card__title {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--color-text);
  line-height: 1.3;
}

.project-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.7;
}

/* Highlights */
.project-highlights {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin-top: var(--space-1);
}

.project-highlight {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.project-highlight i { color: var(--color-primary); flex-shrink: 0; }

/* Foot */
.project-card__foot { margin-top: auto; }

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.tag {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-primary);
  background: var(--color-primary-highlight);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
}

/* ── ÉTAT VIDE ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--space-20) var(--space-8);
  color: var(--color-text-muted);
}

.empty-state__icon {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-offset);
  border-radius: var(--radius-full);
  color: var(--color-text-faint);
  margin-bottom: var(--space-4);
}

.empty-state h3 {
  font-size: var(--text-lg);
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.empty-state p {
  font-size: var(--text-sm);
  margin-bottom: var(--space-6);
}

/* ── BOUTONS ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  min-height: 44px;
  border: 1px solid transparent;
  cursor: pointer;
}

.btn--ghost {
  background: transparent;
  color: var(--color-text);
  border-color: var(--color-border);
}

.btn--ghost:hover {
  background: var(--color-surface-offset);
  border-color: var(--color-text-muted);
}

/* ── RESPONSIVE ── */
@media (max-width: 640px) {
  .filters-section { top: 57px; }
  .projects-grid { grid-template-columns: 1fr; }
}
</style>
