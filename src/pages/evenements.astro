---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// ✏️ PERSONNALISE CES ÉVÉNEMENTS
const events = [
  {
    id: 1,
    title: "Hackathon — Retour vers le futur",
    subtitle: "Récuperer de l'ancien pour imaginer et créer des produits modernes",
    date: "25–27 octobre 2024",
    location: "Bruxelles, Belgique",
    organizer: "EPHEC Louvain-la-Neuve",
    category: "hackathon",
    description: `Dans le cadre d'un hackathon centré sur la seconde vie des appareils électroniques, mon équipe a relevé le défi de redonner vie à un ancien téléphone hors service. En combinant un Raspberry Pi et divers composants électroniques, nous avons reconstruit son fonctionnement de zéro : clavier, sonnerie et interactions de base ont été réintégrés et opérationnels à la fin de l'événement. 
    Ce projet m'a permis de mettre en pratique mes compétences en prototypage rapide, intégration matérielle et travail d'équipe sous contrainte de temps.`,
    participation: `J'ai occupé, avec une autre personne, le rôle de développeur / électronicien sur ce projet en contribuant activement à la partie hardware (câblage, ...) et à l'intégration logicielle (programmation du Raspberry Pi pour gérer les interactions).`,
    result: "Nous n'avons pas été classé au terme de l'épreuve, mais nous avons tout de meme reçu une série de goodies pour notre prototype et notre démarche innovante !",
    resultType: "mention", // "win" | "mention" | "participation"
    tags: ["python", "API", "Electronique", "Travail d'équipe"],
    // Photos : place tes images dans public/assets/evenements/hackathon/
    // et remplace les noms de fichiers ci-dessous.
    // Laisse le tableau vide [] si tu n'as pas encore de photos.
    photos: [
      {
        src: "/assets/evenements/hackathon/photo-1.jpg",
        alt: "Notre équipe au hackathon",
        caption: "Notre équipe au travail — nuit du 15 mars",
      },
      {
        src: "/assets/evenements/hackathon/photo-2.jpg",
        alt: "Présentation du projet",
        caption: "Présentation finale devant le jury",
      },
      {
        src: "/assets/evenements/hackathon/photo-3.jpg",
        alt: "Remise des prix",
        caption: "Remise des récompenses",
      },
    ],
    links: [
      // { label: "Site officiel", url: "https://...", icon: "external-link" },
      // { label: "Notre repo", url: "https://github.com/...", icon: "github" },
    ],
    teammates: [
      // { name: "Prénom Nom", role: "Backend" },
      // { name: "Prénom Nom", role: "Design" },
    ],
  },
  // ── AJOUTE D'AUTRES ÉVÉNEMENTS ICI en dupliquant le bloc ci-dessus ──
];

const categories = [
  { value: "tous",        label: "Tous" },
  { value: "hackathon",   label: "Hackathon" },
  { value: "conference",  label: "Conférence" },
  { value: "workshop",    label: "Workshop" },
  { value: "competition", label: "Compétition" },
];

const resultLabels: Record<string, { label: string; icon: string }> = {
  win:          { label: "Prix remporté",    icon: "trophy" },
  mention:      { label: "Mention spéciale", icon: "award" },
  participation:{ label: "Participation",    icon: "check-circle" },
};
---

<BaseLayout
  title="Événements"
  description="Les événements académiques et professionnels auxquels j'ai participé — hackathons, conférences, workshops."
>
  <Header slot="header" />

  <!-- ── EN-TÊTE PAGE ── -->
  <section class="page-hero">
    <div class="container">
      <p class="page-hero__label">
        <i data-lucide="calendar" width="14" height="14"></i>
        Événements & expériences
      </p>
      <h1 class="page-hero__title">Événements</h1>
      <p class="page-hero__desc">
        Hackathons, conférences, workshops — les événements en lien avec mes études auxquels j'ai participé
        et ce que j'en ai retiré.
      </p>
    </div>
  </section>

  <!-- ── FILTRES ── -->
  <div class="filters-bar">
    <div class="container">
      <div class="filters" role="group" aria-label="Filtrer par type d'événement">
        {categories.map(cat => (
          <button
            class="filter-btn"
            data-filter={cat.value}
            aria-pressed={cat.value === "tous" ? "true" : "false"}
            type="button"
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- ── LISTE DES ÉVÉNEMENTS ── -->
  <section class="events-section">
    <div class="container">
      <div id="events-list">
        {events.map((event) => {
          const result = resultLabels[event.resultType] ?? resultLabels.participation;
          return (
            <article class="event-card" data-category={event.category} id={`event-${event.id}`}>

              <!-- ── COLONNE GAUCHE : méta ── -->
              <aside class="event-meta">
                <div class="event-date-block">
                  <i data-lucide="calendar-days" width="14" height="14"></i>
                  <span>{event.date}</span>
                </div>
                <div class="event-location-block">
                  <i data-lucide="map-pin" width="14" height="14"></i>
                  <span>{event.location}</span>
                </div>
                <div class="event-organizer-block">
                  <i data-lucide="building-2" width="14" height="14"></i>
                  <span>{event.organizer}</span>
                </div>

                {event.teammates.length > 0 && (
                  <div class="event-team-block">
                    <p class="meta-label">
                      <i data-lucide="users" width="13" height="13"></i>
                      Équipe
                    </p>
                    <ul role="list" class="team-list">
                      {event.teammates.map(t => (
                        <li class="team-member">
                          <span class="team-member__name">{t.name}</span>
                          <span class="team-member__role">{t.role}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {event.links.length > 0 && (
                  <div class="event-links-block">
                    {event.links.map(link => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="event-link">
                        <i data-lucide={link.icon} width="13" height="13"></i>
                        {link.label}
                      </a>
                    ))}
                  </div>
                )}
              </aside>

              <!-- ── COLONNE DROITE : contenu ── -->
              <div class="event-content">

                <!-- Header -->
                <header class="event-header">
                  <div class="event-header__top">
                    <span class="event-category-badge">
                      {event.category === "hackathon"    && <i data-lucide="zap"         width="12" height="12"></i>}
                      {event.category === "conference"   && <i data-lucide="mic"         width="12" height="12"></i>}
                      {event.category === "workshop"     && <i data-lucide="wrench"      width="12" height="12"></i>}
                      {event.category === "competition"  && <i data-lucide="trophy"      width="12" height="12"></i>}
                      {event.category}
                    </span>
                    <span class:list={["result-badge", `result-badge--${event.resultType}`]}>
                      <i data-lucide={result.icon} width="12" height="12"></i>
                      {result.label}
                    </span>
                  </div>
                  <h2 class="event-title">{event.title}</h2>
                  <p class="event-subtitle">{event.subtitle}</p>
                </header>

                <!-- Description -->
                <div class="event-body">
                  <div class="event-section">
                    <h3 class="event-section__title">
                      <i data-lucide="info" width="14" height="14"></i>
                      L'événement
                    </h3>
                    <p class="event-text">{event.description}</p>
                  </div>

                  <div class="event-section">
                    <h3 class="event-section__title">
                      <i data-lucide="user" width="14" height="14"></i>
                      Ma participation
                    </h3>
                    <p class="event-text">{event.participation}</p>
                  </div>

                  <div class="event-section event-section--result">
                    <h3 class="event-section__title">
                      <i data-lucide={result.icon} width="14" height="14"></i>
                      Résultat
                    </h3>
                    <p class="event-text">{event.result}</p>
                  </div>
                </div>

                <!-- Tags -->
                <ul role="list" class="event-tags">
                  {event.tags.map(tag => <li class="tag">{tag}</li>)}
                </ul>

                <!-- ── GALERIE PHOTOS ── -->
                {event.photos.length > 0 ? (
                  <div class="photo-gallery">
                    <h3 class="gallery-title">
                      <i data-lucide="images" width="15" height="15"></i>
                      Photos
                    </h3>
                    <div class:list={[
                      "gallery-grid",
                      event.photos.length === 1 && "gallery-grid--1",
                      event.photos.length === 2 && "gallery-grid--2",
                      event.photos.length >= 3  && "gallery-grid--3",
                    ]}>
                      {event.photos.map((photo, i) => (
                        <figure class:list={["gallery-item", i === 0 && event.photos.length >= 3 && "gallery-item--featured"]}>
                          <div class="gallery-img-wrap">
                            <img
                              src={photo.src}
                              alt={photo.alt}
                              width="800"
                              height="500"
                              loading="lazy"
                              decoding="async"
                              class="gallery-img"
                              onerror="this.parentElement.classList.add('gallery-img-wrap--error')"
                            />
                            <!-- Placeholder affiché si la photo n'est pas encore ajoutée -->
                            <div class="gallery-placeholder" aria-hidden="true">
                              <i data-lucide="image" width="24" height="24"></i>
                              <span>Photo à venir</span>
                            </div>
                          </div>
                          {photo.caption && (
                            <figcaption class="gallery-caption">{photo.caption}</figcaption>
                          )}
                        </figure>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div class="photo-gallery">
                    <h3 class="gallery-title">
                      <i data-lucide="images" width="15" height="15"></i>
                      Photos
                    </h3>
                    <div class="gallery-empty">
                      <i data-lucide="camera" width="28" height="28"></i>
                      <p>Les photos seront ajoutées prochainement.</p>
                      <span class="gallery-empty__hint">
                        Place tes images dans <code>public/assets/evenements/hackathon/</code>
                      </span>
                    </div>
                  </div>
                )}

              </div>
            </article>
          );
        })}
      </div>

      <!-- État vide filtre -->
      <div class="empty-state" id="empty-state" hidden>
        <div class="empty-state__icon">
          <i data-lucide="calendar-x" width="28" height="28"></i>
        </div>
        <h3>Aucun événement dans cette catégorie</h3>
        <p>D'autres événements seront ajoutés bientôt.</p>
        <button class="btn btn--ghost" id="reset-filter" type="button">
          Voir tous les événements
        </button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.event-card');
  const emptyState = document.getElementById('empty-state');
  const resetBtn = document.getElementById('reset-filter');

  function applyFilter(value: string) {
    let visible = 0;
    filterBtns.forEach(btn => {
      btn.setAttribute('aria-pressed', String(btn.dataset.filter === value));
    });
    cards.forEach(card => {
      const match = value === 'tous' || card.dataset.category === value;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (emptyState) emptyState.hidden = visible > 0;
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'tous'));
  });
  resetBtn?.addEventListener('click', () => applyFilter('tous'));
</script>

<style>
/* ── PAGE HERO ── */
.page-hero {
  padding-block: clamp(var(--space-12), 8vw, var(--space-24));
  border-bottom: 1px solid var(--color-divider);
}
.page-hero__label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
  margin-bottom: var(--space-3);
}
.page-hero__title {
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--color-text);
  margin-bottom: var(--space-4);
}
.page-hero__desc {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  max-width: 58ch;
  line-height: 1.7;
}

/* ── FILTRES ── */
.filters-bar {
  padding-block: var(--space-5);
  position: sticky;
  top: 61px;
  z-index: 10;
  background: color-mix(in oklab, var(--color-bg) 92%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-divider);
}
.filters {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.filter-btn {
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  background: transparent;
  border: 1px solid var(--color-border);
  min-height: 36px;
  cursor: pointer;
  transition: color var(--transition-interactive), background var(--transition-interactive), border-color var(--transition-interactive);
}
.filter-btn:hover {
  color: var(--color-text);
  border-color: var(--color-text-muted);
  background: var(--color-surface-offset);
}
.filter-btn[aria-pressed="true"] {
  color: var(--color-primary);
  background: var(--color-primary-highlight);
  border-color: var(--color-primary);
}

/* ── SECTION ÉVÉNEMENTS ── */
.events-section {
  padding-block: clamp(var(--space-10), 6vw, var(--space-20));
}

/* ── CARTE ÉVÉNEMENT ── */
.event-card {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: var(--space-8);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--space-8);
  transition: box-shadow var(--transition-interactive);
}
.event-card:hover { box-shadow: var(--shadow-md); }

/* ── META (colonne gauche) ── */
.event-meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding-right: var(--space-8);
  border-right: 1px solid var(--color-divider);
}
.event-date-block,
.event-location-block,
.event-organizer-block {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.4;
}
.event-date-block i,
.event-location-block i,
.event-organizer-block i { color: var(--color-primary); margin-top: 2px; flex-shrink: 0; }

.meta-label {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  margin-bottom: var(--space-2);
}
.team-list { display: flex; flex-direction: column; gap: var(--space-2); }
.team-member { display: flex; flex-direction: column; }
.team-member__name { font-size: var(--text-sm); color: var(--color-text); font-weight: 500; }
.team-member__role { font-size: var(--text-xs); color: var(--color-text-muted); }

.event-links-block { display: flex; flex-direction: column; gap: var(--space-2); margin-top: auto; }
.event-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
  text-decoration: none;
  transition: color var(--transition-interactive);
}
.event-link:hover { color: var(--color-primary-hover); }

/* ── CONTENU (colonne droite) ── */
.event-content { display: flex; flex-direction: column; gap: var(--space-6); min-width: 0; }

.event-header__top {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
  flex-wrap: wrap;
}

.event-category-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--color-text-muted);
  background: var(--color-surface-offset);
  border: 1px solid var(--color-border);
  padding: 3px var(--space-2);
  border-radius: var(--radius-full);
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 3px var(--space-2);
  border-radius: var(--radius-full);
}
.result-badge--win         { color: #d19900; background: #e9e0c6; }
.result-badge--mention     { color: var(--color-primary); background: var(--color-primary-highlight); }
.result-badge--participation { color: #437a22; background: #d4dfcc; }

[data-theme="dark"] .result-badge--win          { color: #e8af34; background: #4d4332; }
[data-theme="dark"] .result-badge--mention      { color: var(--color-primary); background: var(--color-primary-highlight); }
[data-theme="dark"] .result-badge--participation{ color: #6daa45; background: #3a4435; }

.event-title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin-bottom: var(--space-1);
}
.event-subtitle {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  font-weight: 500;
}

/* Sections de texte */
.event-body { display: flex; flex-direction: column; gap: var(--space-5); }
.event-section { display: flex; flex-direction: column; gap: var(--space-2); }
.event-section--result {
  background: var(--color-surface-offset);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}
.event-section__title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.event-section__title i { color: var(--color-primary); }
.event-text {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.75;
  white-space: pre-line;
}

/* Tags */
.event-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.tag {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-primary);
  background: var(--color-primary-highlight);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
}

/* ── GALERIE PHOTOS ── */
.photo-gallery { display: flex; flex-direction: column; gap: var(--space-4); }
.gallery-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.gallery-title i { color: var(--color-primary); }

/* Grilles selon nombre de photos */
.gallery-grid { display: grid; gap: var(--space-3); }
.gallery-grid--1 { grid-template-columns: 1fr; max-width: 640px; }
.gallery-grid--2 { grid-template-columns: repeat(2, 1fr); }
.gallery-grid--3 { grid-template-columns: repeat(3, 1fr); grid-template-rows: auto; }

/* La 1re photo plus grande quand il y en a 3+ */
.gallery-item--featured {
  grid-column: 1 / -1;
}

.gallery-img-wrap {
  position: relative;
  aspect-ratio: 16 / 10;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-surface-offset);
  border: 1px solid var(--color-border);
}

.gallery-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
}

.gallery-img-wrap:hover .gallery-img { transform: scale(1.03); }

/* Placeholder visible par défaut, masqué quand l'image charge */
.gallery-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  pointer-events: none;
  z-index: 0;
}

/* Quand l'image est chargée, elle passe devant le placeholder */
.gallery-img { position: relative; z-index: 1; }

/* Si erreur de chargement : on montre le placeholder */
.gallery-img-wrap--error .gallery-img { opacity: 0; }
.gallery-img-wrap--error .gallery-placeholder { z-index: 2; }

.gallery-caption {
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  text-align: center;
}

/* Galerie vide */
.gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  padding: var(--space-10);
  background: var(--color-surface-offset);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-lg);
  text-align: center;
  color: var(--color-text-faint);
}
.gallery-empty p { font-size: var(--text-sm); color: var(--color-text-muted); }
.gallery-empty__hint { font-size: var(--text-xs); color: var(--color-text-faint); }
.gallery-empty__hint code {
  font-family: monospace;
  background: var(--color-surface-dynamic);
  padding: 2px var(--space-1);
  border-radius: var(--radius-sm);
}

/* ── ÉTAT VIDE FILTRE ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--space-20) var(--space-8);
  color: var(--color-text-muted);
}
.empty-state__icon {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-offset);
  border-radius: var(--radius-full);
  color: var(--color-text-faint);
  margin-bottom: var(--space-4);
}
.empty-state h3 { font-size: var(--text-lg); color: var(--color-text); margin-bottom: var(--space-2); }
.empty-state p  { font-size: var(--text-sm); margin-bottom: var(--space-6); }

.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-md);
