---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// ✏️ PERSONNALISE CES JOBS ÉTUDIANTS
const jobs = [
  {
    id: 1,
    title: "Caissier & Mise en rayon",
    company: "Delhaize Herman-Debroux",
    location: "Bruxelles, Belgique",
    type: "Job étudiant",
    sector: "Grande distribution",
    startDate: "2019",
    endDate: "2021",
    current: false,
    description: "Job étudiant au sein du supermarché Delhaize d'Herman-Debroux. Travail en caisse et participation active à la gestion des rayons en magasin.",
    missions: [
      "Accueil et encaissement des clients en caisse",
      "Mise en rayon et réassort des produits",
      "Vérification des dates et rotation des stocks",
    ],
    skills: ["Service client", "Gestion des stocks", "Rigueur", "Travail en équipe"],
  },
  {
    id: 2,
    title: "Service en salle",
    company: "Fox Food Market",
    location: "Bruxelles, Belgique",
    type: "Job étudiant",
    sector: "Horeca",
    startDate: "2022",
    endDate: "2025",
    current: false,
    description: "Service en salle au Fox Food Market, établissement de restauration bruxellois. Prise en charge des clients du début à la fin de leur expérience, dans un environnement dynamique et rythmé.",
    missions: [
      "Accueil, placement et service des clients en salle",
      "Prise de commandes et suivi des tables",
      "Coordination avec la cuisine et gestion du flux de service",
    ],
    skills: ["Relation client", "Travail sous pression", "Organisation", "Communication"],
  },
  {
    id: 3,
    title: "Développeur web — Jobbiste",
    company: "Braft",
    location: "Bruxelles, Belgique",
    type: "Job étudiant",
    sector: "Start-up / Intelligence artificielle",
    startDate: "22 Janvier 2026",
    endDate: "3 Février 2026",
    current: false,
    description: "Semaine de jobbiste au sein de Braft, une start-up bruxelloise développant une IA sécurisée conçue pour garder les documents et données strictement au sein de l'entreprise, sans aucune fuite externe. J'ai contribué au développement de l'interface visuelle de cette IA.",
    missions: [
      "Développement frontend de l'interface web de l'IA en React",
      "Intégration avec le backend Python de l'application",
      "Participation aux échanges techniques avec l'équipe de la start-up",
    ],
    skills: ["React", "Python", "Frontend", "IA", "Start-up"],
    photos: [
      {
        src: "/assets/braft-photo/Colibri.jpeg",
        alt: "Interface de l'application Braft",
        caption: "Page d'accueil de l'application web Colibri sur laquelle j'ai travaillé",
      },
      {
        src: "/assets/braft-photo/Chatbot2.jpeg",
        alt: "Interface de chat avec l'IA",
        caption: "Interface de chat avec l'IA, intégrant les fonctionnalités sur lesquelles j'ai travaillé",
      },
      {
        src: "/assets/braft-photo/environement.png",
        alt: "Environnement de travail chez Braft",
        caption: "Dans les locaux de la start-up",
      },
    ],
  },
];

// Compétences transversales développées grâce aux jobs étudiants
const softSkills = [
  { icon: "users",        label: "Travail en équipe" },
  { icon: "clock",        label: "Gestion du temps" },
  { icon: "message-circle", label: "Communication" },
  { icon: "zap",          label: "Adaptabilité" },
  { icon: "shield-check", label: "Sens des responsabilités" },
  { icon: "star",         label: "Rigueur" },
];
---

<BaseLayout
  title="Jobs étudiants"
  description="Mes expériences professionnelles parallèles à mes études."
>
  <Header slot="header" />

  <!-- ── EN-TÊTE PAGE ── -->
  <section class="page-hero">
    <div class="container">
      <p class="page-hero__label">
        <i data-lucide="briefcase" width="14" height="14"></i>
        Expériences parallèles
      </p>
      <h1 class="page-hero__title">Jobs étudiants</h1>
      <p class="page-hero__desc">
        En parallèle de mes études, j'ai occupé plusieurs postes qui m'ont permis
        de développer des compétences pratiques et transversales précieuses.
      </p>

      <!-- Compteur -->
      <div class="hero-stats">
        <div class="stat">
          <span class="stat__value">{jobs.length}</span>
          <span class="stat__label">expériences</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat__value">{jobs.filter(j => j.current).length > 0 ? jobs.filter(j => j.current).length : jobs.length}</span>
          <span class="stat__label">{jobs.filter(j => j.current).length > 0 ? "en cours" : "terminées"}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TIMELINE DES JOBS ── -->
  <section class="jobs-section">
    <div class="container">
      <div class="jobs-timeline">
        {jobs.map((job, index) => (
          <article class="job-card" id={`job-${job.id}`}>

            <!-- Indicateur timeline -->
            <div class="timeline-indicator" aria-hidden="true">
              <div class:list={["timeline-dot", job.current && "timeline-dot--active"]}></div>
              {index < jobs.length - 1 && <div class="timeline-line"></div>}
            </div>

            <!-- Contenu de la carte -->
            <div class="job-card__content">

              <!-- Head -->
              <div class="job-card__head">
                <div class="job-card__dates">
                  <span class="job-date">
                    <i data-lucide="calendar" width="12" height="12"></i>
                    {job.startDate} → {job.endDate}
                  </span>
                  {job.current && (
                    <span class="job-badge job-badge--current">
                      <i data-lucide="loader" width="11" height="11"></i>
                      En cours
                    </span>
                  )}
                </div>
                <div class="job-type-tag">{job.type}</div>
              </div>

              <!-- Titre & entreprise -->
              <div class="job-card__title-block">
                <h2 class="job-title">{job.title}</h2>
                <div class="job-company-info">
                  <span class="job-company">
                    <i data-lucide="building-2" width="13" height="13"></i>
                    {job.company}
                  </span>
                  <span class="job-sep" aria-hidden="true">·</span>
                  <span class="job-location">
                    <i data-lucide="map-pin" width="12" height="12"></i>
                    {job.location}
                  </span>
                  <span class="job-sep" aria-hidden="true">·</span>
                  <span class="job-sector">
                    <i data-lucide="tag" width="12" height="12"></i>
                    {job.sector}
                  </span>
                </div>
              </div>

              <!-- Description -->
              <p class="job-desc">{job.description}</p>

              <!-- Missions -->
              {job.missions.length > 0 && (
                <div class="job-missions">
                  <h3 class="missions-label">Missions principales</h3>
                  <ul role="list" class="missions-list">
                    {job.missions.map(m => (
                      <li class="mission-item">
                        <i data-lucide="chevron-right" width="13" height="13"></i>
                        {m}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Compétences -->
              {job.skills.length > 0 && (
                <ul role="list" class="job-skills">
                  {job.skills.map(skill => (
                    <li class="skill-tag">{skill}</li>
                  ))}
                </ul>
              )}

              <!-- Galerie photos -->
              {job.photos && job.photos.length > 0 && (
                <div class="job-gallery">
                  <h3 class="job-gallery__title">
                    <i data-lucide="images" width="14" height="14"></i>
                    Photos
                  </h3>
                  <div class="job-gallery__grid">
                    {job.photos.map(photo => (
                      <figure class="job-gallery__item">
                        <div class="job-gallery__img-wrap">
                          <img
                            src={photo.src}
                            alt={photo.alt}
                            width="800"
                            height="500"
                            loading="lazy"
                            decoding="async"
                            class="job-gallery__img"
                          />
                        </div>
                        {photo.caption && (
                          <figcaption class="job-gallery__caption">{photo.caption}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                </div>
              )}

            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── COMPÉTENCES TRANSVERSALES ── -->
  <section class="softskills-section">
    <div class="container">
      <div class="softskills-header">
        <h2 class="softskills-title">Compétences développées</h2>
        <p class="softskills-sub">Au-delà du technique, ces expériences ont renforcé des qualités humaines essentielles.</p>
      </div>
      <div class="softskills-grid">
        {softSkills.map(skill => (
          <div class="softskill-card">
            <span class="softskill-icon" aria-hidden="true">
              <i data-lucide={skill.icon} width="18" height="18"></i>
            </span>
            <span class="softskill-label">{skill.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
/* ── PAGE HERO ── */
.page-hero {
  padding-block: clamp(var(--space-12), 8vw, var(--space-24));
  border-bottom: 1px solid var(--color-divider);
}
.page-hero__label {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-sm); font-weight: 500; color: var(--color-primary);
  margin-bottom: var(--space-3);
}
.page-hero__title {
  font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 700;
  letter-spacing: -0.03em; color: var(--color-text); margin-bottom: var(--space-4);
}
.page-hero__desc {
  font-size: var(--text-base); color: var(--color-text-muted);
  max-width: 58ch; line-height: 1.7; margin-bottom: var(--space-8);
}
.hero-stats { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; }
.stat { display: flex; flex-direction: column; gap: var(--space-1); }
.stat__value {
  font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700;
  letter-spacing: -0.03em; color: var(--color-text); line-height: 1;
}
.stat__label {
  font-size: var(--text-xs); font-weight: 500; color: var(--color-text-muted);
  text-transform: uppercase; letter-spacing: 0.07em;
}
.stat-divider { width: 1px; height: 32px; background: var(--color-divider); }

/* ── SECTION JOBS ── */
.jobs-section { padding-block: clamp(var(--space-12), 8vw, var(--space-24)); }

/* ── TIMELINE ── */
.jobs-timeline { display: flex; flex-direction: column; gap: 0; }

.job-card {
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: 0 var(--space-6);
}

/* Indicateur */
.timeline-indicator {
  display: flex; flex-direction: column; align-items: center;
  padding-top: var(--space-1);
}
.timeline-dot {
  width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0;
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  transition: border-color var(--transition-interactive), background var(--transition-interactive);
  z-index: 1;
}
.timeline-dot--active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4px var(--color-primary-highlight);
}
.timeline-line {
  width: 2px; flex: 1;
  background: var(--color-divider);
  margin-block: var(--space-2);
  min-height: var(--space-8);
}

/* Contenu de la carte */
.job-card__content {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  margin-bottom: var(--space-6);
  box-shadow: var(--shadow-sm);
  display: flex; flex-direction: column; gap: var(--space-4);
  transition: box-shadow var(--transition-interactive), border-color var(--transition-interactive), transform var(--transition-interactive);
}
.job-card__content:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--color-primary-highlight);
  transform: translateX(4px);
}

/* Head */
.job-card__head {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3);
}
.job-card__dates { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
.job-date {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-xs); color: var(--color-text-muted);
}
.job-date i { color: var(--color-primary); }
.job-badge {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-xs); font-weight: 500;
  padding: 3px var(--space-2); border-radius: var(--radius-full);
}
.job-badge--current { color: #964219; background: #ddcfc6; }
[data-theme="dark"] .job-badge--current { color: #bb653b; background: #564942; }
.job-type-tag {
  font-size: var(--text-xs); font-weight: 600;
  color: var(--color-text-muted);
  background: var(--color-surface-offset);
  border: 1px solid var(--color-border);
  padding: 3px var(--space-3); border-radius: var(--radius-full);
}

/* Titre */
.job-card__title-block { display: flex; flex-direction: column; gap: var(--space-2); }
.job-title {
  font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;
  letter-spacing: -0.02em; color: var(--color-text); line-height: 1.2;
}
.job-company-info {
  display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;
}
.job-company, .job-location, .job-sector {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-sm); color: var(--color-text-muted);
}
.job-company { font-weight: 600; color: var(--color-text); }
.job-company i, .job-location i, .job-sector i { color: var(--color-primary); }
.job-sep { color: var(--color-text-faint); font-size: var(--text-xs); }

/* Description */
.job-desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.75; }

/* Missions */
.job-missions { display: flex; flex-direction: column; gap: var(--space-2); }
.missions-label {
  font-size: var(--text-xs); font-weight: 600; color: var(--color-text-muted);
  text-transform: uppercase; letter-spacing: 0.07em;
}
.missions-list { display: flex; flex-direction: column; gap: var(--space-2); }
.mission-item {
  display: flex; align-items: flex-start; gap: var(--space-2);
  font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.5;
}
.mission-item i { color: var(--color-primary); flex-shrink: 0; margin-top: 3px; }

/* Skills */
.job-skills { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.skill-tag {
  font-size: var(--text-xs); font-weight: 500;
  color: var(--color-primary); background: var(--color-primary-highlight);
  padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm);
}

/* ── SOFT SKILLS ── */
.softskills-section {
  padding-block: clamp(var(--space-10), 6vw, var(--space-16));
  border-top: 1px solid var(--color-divider);
  background: var(--color-surface);
}
.softskills-header { margin-bottom: var(--space-8); }
.softskills-title {
  font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;
  letter-spacing: -0.02em; color: var(--color-text); margin-bottom: var(--space-2);
}
.softskills-sub { font-size: var(--text-sm); color: var(--color-text-muted); max-width: 52ch; }
.softskills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
  gap: var(--space-3);
}
.softskill-card {
  display: flex; align-items: center; gap: var(--space-3);
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: var(--space-4);
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-interactive), border-color var(--transition-interactive), transform var(--transition-interactive);
}
.softskill-card:hover {
  box-shadow: var(--shadow-md); border-color: var(--color-primary-highlight); transform: translateY(-2px);
}
.softskill-icon {
  display: flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; border-radius: var(--radius-md); flex-shrink: 0;
  background: var(--color-primary-highlight); color: var(--color-primary);
}
.softskill-label { font-size: var(--text-sm); font-weight: 500; color: var(--color-text); }

/* ── RESPONSIVE ── */
@media (max-width: 640px) {
  .job-card { grid-template-columns: 20px 1fr; gap: 0 var(--space-4); }
  .job-card__head { flex-direction: column; align-items: flex-start; }
  .job-company-info { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
  .job-sep { display: none; }
}
/* ── GALERIE JOB ── */
.job-gallery {
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-divider);
}

.job-gallery__title {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-4);
}

.job-gallery__title i { color: var(--color-primary); }

.job-gallery__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
}

.job-gallery__img-wrap {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  background: var(--color-surface-offset);
}

.job-gallery__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 300ms var(--transition-interactive);
}

.job-gallery__img-wrap:hover .job-gallery__img { transform: scale(1.03); }

.job-gallery__caption {
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  text-align: center;
}

@media (max-width: 640px) {
  .job-gallery__grid { grid-template-columns: 1fr; }
}
</style>
