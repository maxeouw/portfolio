---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contact = {
  email:    "edwardgay02@yahoo.com",
  github:   "https://github.com/maxeouw",
  linkedin: "https://linkedin.com/in/tonpseudo",
  location: "Bruxelles, Belgique",
};

const reasons = [
  { icon: "briefcase",      label: "Opportunité de stage ou d'emploi" },
  { icon: "code-2",         label: "Collaboration sur un projet" },
  { icon: "message-circle", label: "Question sur mon travail" },
  { icon: "users",          label: "Prise de contact générale" },
];

// ✏️ PERSONNALISE TON CV
const cv = {
  file:        "/assets/cv/cv-edward-gay.pdf",
  lastUpdated: "Mai 2026",
  preview:     null, // ex: "/assets/cv/cv-preview.png"
};
---

<BaseLayout title="Contact" description="Me contacter pour une opportunité, une collaboration ou une question.">
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <p class="page-hero__label">
        <i data-lucide="send" width="14" height="14"></i>
        Me contacter
      </p>
      <h1 class="page-hero__title">Travaillons ensemble</h1>
      <p class="page-hero__desc">
        Disponible pour un stage, une première opportunité professionnelle ou une collaboration.
        N'hésite pas à me contacter directement par email ou via mes réseaux.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-layout">

        <aside class="contact-info">
          <div class="availability-card">
            <div class="availability-dot" aria-hidden="true"></div>
            <div>
              <p class="availability-title">Disponible actuellement</p>
              <p class="availability-sub">Ouvert aux opportunités dès juin 2026</p>
            </div>
          </div>

          <div class="info-block">
            <h2 class="info-block__title">Tu peux me contacter pour…</h2>
            <ul role="list" class="reasons-list">
              {reasons.map(r => (
                <li class="reason-item">
                  <span class="reason-icon" aria-hidden="true">
                    <i data-lucide={r.icon} width="15" height="15"></i>
                  </span>
                  {r.label}
                </li>
              ))}
            </ul>
          </div>

          <div class="info-block">
            <h2 class="info-block__title">Coordonnées</h2>
            <ul role="list" class="coords-list">
              <li>
                <a href={`mailto:${contact.email}`} class="coord-link">
                  <span class="coord-icon"><i data-lucide="mail" width="15" height="15"></i></span>
                  <span class="coord-text">
                    <span class="coord-label">Email</span>
                    <span class="coord-value">{contact.email}</span>
                  </span>
                </a>
              </li>
              <li>
                <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="coord-link">
                  <span class="coord-icon"><i data-lucide="linkedin" width="15" height="15"></i></span>
                  <span class="coord-text">
                    <span class="coord-label">LinkedIn</span>
                    <span class="coord-value">Voir mon profil</span>
                  </span>
                  <i data-lucide="arrow-up-right" width="13" height="13" class="coord-arrow"></i>
                </a>
              </li>
              <li>
                <a href={contact.github} target="_blank" rel="noopener noreferrer" class="coord-link">
                  <span class="coord-icon"><i data-lucide="github" width="15" height="15"></i></span>
                  <span class="coord-text">
                    <span class="coord-label">GitHub</span>
                    <span class="coord-value">Voir mes repos</span>
                  </span>
                  <i data-lucide="arrow-up-right" width="13" height="13" class="coord-arrow"></i>
                </a>
              </li>
              <li>
                <span class="coord-link coord-link--static">
                  <span class="coord-icon"><i data-lucide="map-pin" width="15" height="15"></i></span>
                  <span class="coord-text">
                    <span class="coord-label">Localisation</span>
                    <span class="coord-value">{contact.location}</span>
                  </span>
                </span>
              </li>
            </ul>
          </div>
        </aside>

        <div class="contact-right">

          <!-- ── SECTION CV ── -->
          <div class="cv-card">
            <div class="cv-card__header">
              <div class="cv-card__icon" aria-hidden="true">
                <i data-lucide="file-text" width="24" height="24"></i>
              </div>
              <div>
                <h2 class="cv-card__title">Mon CV</h2>
                <p class="cv-card__sub">Mis à jour en {cv.lastUpdated}</p>
              </div>
            </div>

            <div class="cv-card__actions">
              <a
                href={cv.file}
                download
                class="btn btn--primary"
                aria-label="Télécharger le CV de Gay Edward (PDF)"
              >
                <i data-lucide="download" width="16" height="16"></i>
                Télécharger le CV
              </a>
              <a
                href={cv.file}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--ghost"
                aria-label="Voir le CV en plein écran"
              >
                <i data-lucide="external-link" width="16" height="16"></i>
                Ouvrir en plein écran
              </a>
            </div>

            <p class="cv-card__note">
              <i data-lucide="info" width="12" height="12"></i>
              Format PDF · Optimisé pour impression A4
            </p>
          </div>

          <!-- ── CONTACT DIRECT ── -->
          <div class="direct-contact-card">
            <div class="direct-contact__icon" aria-hidden="true">
              <i data-lucide="mail" width="22" height="22"></i>
            </div>
            <div class="direct-contact__content">
              <h2 class="direct-contact__title">Envoie-moi un email</h2>
              <p class="direct-contact__desc">
                Pour toute question ou opportunité, la façon la plus directe de me joindre
                reste l'email. Je réponds généralement sous 48h.
              </p>
              <a
                href={`mailto:${contact.email}?subject=Prise%20de%20contact%20via%20portfolio`}
                class="btn btn--primary"
              >
                <i data-lucide="send" width="16" height="16"></i>
                {contact.email}
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
.page-hero {
  padding-block: clamp(var(--space-12), 8vw, var(--space-24));
  border-bottom: 1px solid var(--color-divider);
}
.page-hero__label {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-sm); font-weight: 500; color: var(--color-primary);
  margin-bottom: var(--space-3);
}
.page-hero__title {
  font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 700;
  letter-spacing: -0.03em; color: var(--color-text); margin-bottom: var(--space-4);
}
.page-hero__desc {
  font-size: var(--text-base); color: var(--color-text-muted);
  max-width: 58ch; line-height: 1.7;
}

/* ── LAYOUT ── */
.contact-section { padding-block: clamp(var(--space-12), 8vw, var(--space-24)); }
.contact-layout {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: var(--space-12);
  align-items: start;
}

/* ── COLONNE GAUCHE ── */
.contact-info {
  display: flex; flex-direction: column; gap: var(--space-6);
  position: sticky; top: calc(61px + var(--space-6));
}

.availability-card {
  display: flex; align-items: center; gap: var(--space-3);
  background: var(--color-surface); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5);
  box-shadow: var(--shadow-sm);
}
.availability-dot {
  width: 10px; height: 10px; border-radius: 50%; background: #437a22; flex-shrink: 0;
  box-shadow: 0 0 0 3px #d4dfcc;
  animation: pulse-dot 2s ease-in-out infinite;
}
[data-theme="dark"] .availability-dot { background: #6daa45; box-shadow: 0 0 0 3px #3a4435; }
@keyframes pulse-dot {
  0%, 100% { box-shadow: 0 0 0 3px #d4dfcc; }
  50%       { box-shadow: 0 0 0 6px #d4dfcc80; }
}
.availability-title { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); }
.availability-sub   { font-size: var(--text-xs); color: var(--color-text-muted); }

.info-block { display: flex; flex-direction: column; gap: var(--space-3); }
.info-block__title {
  font-size: var(--text-xs); font-weight: 600; color: var(--color-text-muted);
  text-transform: uppercase; letter-spacing: 0.08em;
}

.reasons-list { display: flex; flex-direction: column; gap: var(--space-2); }
.reason-item {
  display: flex; align-items: center; gap: var(--space-2);
  font-size: var(--text-sm); color: var(--color-text-muted);
}
.reason-icon {
  display: flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; border-radius: var(--radius-md);
  background: var(--color-primary-highlight); color: var(--color-primary); flex-shrink: 0;
}

.coords-list { display: flex; flex-direction: column; gap: var(--space-1); }
.coord-link {
  display: flex; align-items: center; gap: var(--space-3);
  padding: var(--space-3); border-radius: var(--radius-lg);
  text-decoration: none; color: inherit;
  transition: background var(--transition-interactive);
}
.coord-link:not(.coord-link--static):hover { background: var(--color-surface-offset); }
.coord-link--static { cursor: default; }
.coord-icon {
  display: flex; align-items: center; justify-content: center;
  width: 32px; height: 32px; border-radius: var(--radius-md);
  background: var(--color-surface-offset); color: var(--color-primary); flex-shrink: 0;
}
.coord-text  { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
.coord-label { font-size: var(--text-xs); color: var(--color-text-muted); }
.coord-value { font-size: var(--text-sm); font-weight: 500; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.coord-arrow { color: var(--color-text-faint); flex-shrink: 0; }

/* ── COLONNE DROITE ── */
.contact-right { display: flex; flex-direction: column; gap: var(--space-6); }

/* ── CV CARD ── */
.cv-card {
  background: var(--color-surface); border: 1px solid var(--color-border);
  border-radius: var(--radius-xl); padding: var(--space-8);
  box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: var(--space-6);
}
.cv-card__header { display: flex; align-items: center; gap: var(--space-4); }
.cv-card__icon {
  display: flex; align-items: center; justify-content: center;
  width: 52px; height: 52px; border-radius: var(--radius-lg); flex-shrink: 0;
  background: var(--color-primary-highlight); color: var(--color-primary);
}
.cv-card__title {
  font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;
  letter-spacing: -0.02em; color: var(--color-text);
}
.cv-card__sub { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: var(--space-1); }

.cv-preview { border-radius: var(--radius-lg); border: 1px solid var(--color-border); overflow: hidden; box-shadow: var(--shadow-md); }
.cv-preview__img { width: 100%; height: auto; display: block; transition: transform 400ms ease; }
.cv-preview:hover .cv-preview__img { transform: scale(1.01); }

.cv-placeholder {
  border-radius: var(--radius-lg); border: 2px dashed var(--color-border);
  background: var(--color-surface-offset); min-height: 200px;
  display: flex; align-items: center; justify-content: center;
}
.cv-placeholder__inner {
  display: flex; flex-direction: column; align-items: center;
  gap: var(--space-3); color: var(--color-text-faint);
  font-size: var(--text-sm); text-align: center; padding: var(--space-6);
}
.cv-placeholder__inner code {
  font-size: var(--text-xs); background: var(--color-surface-dynamic);
  padding: 2px var(--space-2); border-radius: var(--radius-sm);
  color: var(--color-primary);
}
.cv-placeholder__hint { font-size: var(--text-xs); color: var(--color-text-faint); max-width: 42ch; text-align: center; line-height: 1.6; }

.cv-card__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
.cv-card__note {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-xs); color: var(--color-text-faint);
}

/* ── CONTACT DIRECT ── */
.direct-contact-card {
  display: flex; align-items: flex-start; gap: var(--space-5);
  background: var(--color-surface); border: 1px solid var(--color-border);
  border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);
}
.direct-contact__icon {
  display: flex; align-items: center; justify-content: center;
  width: 52px; height: 52px; border-radius: var(--radius-lg); flex-shrink: 0;
  background: var(--color-primary-highlight); color: var(--color-primary);
}
.direct-contact__content { display: flex; flex-direction: column; gap: var(--space-3); }
.direct-contact__title {
  font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;
  letter-spacing: -0.02em; color: var(--color-text);
}
.direct-contact__desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; max-width: 52ch; }

/* ── BOUTONS ── */
.btn {
  display: inline-flex; align-items: center; gap: var(--space-2);
  padding: var(--space-3) var(--space-5); border-radius: var(--radius-md);
  font-size: var(--text-sm); font-weight: 600; min-height: 44px;
  border: 1px solid transparent; cursor: pointer; white-space: nowrap; text-decoration: none;
}
.btn--primary { background: var(--color-primary); color: var(--color-text-inverse); border-color: var(--color-primary); }
.btn--primary:hover { background: var(--color-primary-hover); border-color: var(--color-primary-hover); }
.btn--ghost { background: transparent; color: var(--color-text); border-color: var(--color-border); }
.btn--ghost:hover { background: var(--color-surface-offset); border-color: var(--color-text-muted); }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .contact-layout { grid-template-columns: 1fr; }
  .contact-info   { position: static; }
}
@media (max-width: 560px) {
  .cv-card__actions     { flex-direction: column; }
  .direct-contact-card  { flex-direction: column; }
}
</style>
