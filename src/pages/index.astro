---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// ✏️ PERSONNALISE CES DONNÉES
const hero = {
  name: "Gay Edward",
  role: "Développeur web & étudiant en informatique",
  tagline: "Je conçois des applications web soignées, de l'idée au déploiement.",
  location: "Bruxelles, Belgique",
  github: "https://github.com/maxeouw",
  linkedin: "https://linkedin.com/in/tonpseudo",
  email: "edwardgay02@yahoo.com",
};

const skills = [
  { category: "Frontend",  items: ["HTML/CSS", "JavaScript", "TypeScript", "Astro", "React","Laravel"] },
  { category: "Backend",   items: ["Python", "Node.js", "MongoDB", "PostgreSQL", "PHP", "C#"] },
  { category: "DevOps",    items: ["Git", "Docker", "GitHub Actions", "Linux", "Azure"] },
  { category: "Outils",    items: ["VS Code", "Draw.io", "Postman", "Figma", "Odoo", "Notion"] },
];

const featuredProjects = [
  {
    title: "Dashboard système — raspberry pi",
    description: "Dashboard de monitoring hardware avec raspberry pi",
    tags: ["React", "python", "raspberry pi"],
    link: "/projets",
    featured: true,
  },
];
---

<BaseLayout title="Accueil" description={hero.tagline}>
  <Header slot="header" />

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__location">
          <i data-lucide="map-pin" width="14" height="14"></i>
          {hero.location}
        </span>

        <h1 class="hero__name">{hero.name}</h1>
        <p class="hero__role">{hero.role}</p>
        <p class="hero__tagline">{hero.tagline}</p>

        <div class="hero__ctas">
          <a href="/projets" class="btn btn--primary">
            Voir mes projets
            <i data-lucide="arrow-right" width="16" height="16"></i>
          </a>
          <a href={hero.github} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
            <i data-lucide="github" width="16" height="16"></i>
            GitHub
          </a>
        </div>

        <div class="hero__social">
          <a href={hero.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <i data-lucide="linkedin" width="18" height="18"></i>
          </a>
          <a href={`mailto:${hero.email}`} aria-label="Email">
            <i data-lucide="mail" width="18" height="18"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── COMPÉTENCES ── -->
  <section class="skills fade-in">
    <div class="container">
      <h2 class="section-title">Compétences</h2>
      <div class="skills__grid">
        {skills.map(group => (
          <div class="skill-card">
            <h3 class="skill-card__title">{group.category}</h3>
            <ul role="list" class="skill-card__list">
              {group.items.map(item => (
                <li class="skill-tag">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PROJETS EN VEDETTE ── -->
  <section class="featured fade-in">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Projets récents</h2>
        <a href="/projets" class="see-all">
          Tous les projets
          <i data-lucide="arrow-right" width="14" height="14"></i>
        </a>
      </div>

      <div class="projects__grid">
        {featuredProjects.map((project, i) => (
          <article class:list={["project-card", { "project-card--featured": project.featured }]}>
            <div class="project-card__body">
              <h3 class="project-card__title">{project.title}</h3>
              <p class="project-card__desc">{project.description}</p>
              <ul role="list" class="project-card__tags">
                {project.tags.map(tag => <li class="tag">{tag}</li>)}
              </ul>
            </div>
            <a href={project.link} class="project-card__link" aria-label={`Voir le projet ${project.title}`}>
              Voir le projet
              <i data-lucide="arrow-right" width="14" height="14"></i>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA CONTACT ── -->
  <section class="cta fade-in">
    <div class="container">
      <div class="cta__inner">
        <h2 class="cta__title">Travaillons ensemble</h2>
        <p class="cta__text">Disponible pour un stage ou une première opportunité professionnelle. N'hésite pas à me contacter.</p>
        <a href="/contact" class="btn btn--primary">
          Me contacter
          <i data-lucide="send" width="16" height="16"></i>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
/* ── HERO ── */
.hero {
  padding-block: clamp(var(--space-16), 12vw, var(--space-32));
  position: relative;
}

.hero__inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-12);
  align-items: center;
}

.hero__content { max-width: 600px; }

.hero__location {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
}

.hero__name {
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.hero__role {
  font-size: var(--text-lg);
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: var(--space-4);
}

.hero__tagline {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: var(--space-8);
  max-width: 52ch;
}

.hero__ctas {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-6);
}

.hero__social {
  display: flex;
  gap: var(--space-4);
}

.hero__social a {
  color: var(--color-text-faint);
  transition: color var(--transition-interactive);
}

.hero__social a:hover { color: var(--color-primary); }

/* Avatar */
.hero__avatar { flex-shrink: 0; }

.avatar-placeholder {
  width: 220px;
  height: 220px;
  border-radius: var(--radius-xl);
  background: var(--color-surface-offset);
  border: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-faint);
}

/* ── BOUTONS ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  min-height: 44px;
  border: 1px solid transparent;
}

.btn--primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border-color: var(--color-primary);
}

.btn--primary:hover {
  background: var(--color-primary-hover);
  border-color: var(--color-primary-hover);
}

.btn--ghost {
  background: transparent;
  color: var(--color-text);
  border-color: var(--color-border);
}

.btn--ghost:hover {
  background: var(--color-surface-offset);
  border-color: var(--color-text-muted);
}

/* ── SECTION COMMUNES ── */
.section-title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin-bottom: var(--space-8);
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-8);
  flex-wrap: wrap;
  gap: var(--space-4);
}

.section-header .section-title { margin-bottom: 0; }

.see-all {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-primary);
}

.see-all:hover { color: var(--color-primary-hover); }

/* ── COMPÉTENCES ── */
.skills {
  padding-block: clamp(var(--space-12), 6vw, var(--space-20));
}

.skills__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--space-4);
}

.skill-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  box-shadow: var(--shadow-sm);
}

.skill-card__title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-3);
}

.skill-card__list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.skill-tag {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text);
  background: var(--color-surface-offset);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
}

/* ── PROJETS ── */
.featured {
  padding-block: clamp(var(--space-12), 6vw, var(--space-20));
}

.projects__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
  gap: var(--space-5);
}

.project-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-interactive), transform var(--transition-interactive);
}

.project-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.project-card--featured {
  background: var(--color-surface-2);
  border-color: var(--color-primary-highlight);
  grid-column: span 2;
}

.project-card__body { flex: 1; }

.project-card__title {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-3);
}

.project-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.65;
  margin-bottom: var(--space-4);
}

.project-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.tag {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-primary);
  background: var(--color-primary-highlight);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
}

.project-card__link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: none;
  transition: gap var(--transition-interactive);
}

.project-card__link:hover { gap: var(--space-2); }

/* ── CTA ── */
.cta {
  padding-block: clamp(var(--space-12), 6vw, var(--space-20));
}

.cta__inner {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: clamp(var(--space-8), 5vw, var(--space-16));
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.cta__title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
}

.cta__text {
  color: var(--color-text-muted);
  max-width: 48ch;
  margin-inline: auto;
  margin-bottom: var(--space-6);
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .hero__inner {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero__content { max-width: 100%; }
  .hero__ctas { justify-content: center; }
  .hero__social { justify-content: center; }
  .hero__location { justify-content: center; }
  .hero__tagline { max-width: 100%; }
  .hero__avatar { justify-self: center; }
  .avatar-placeholder { width: 160px; height: 160px; }
  .project-card--featured { grid-column: span 1; }
}
</style>